node_modules/

# ── Environment files ─────────────────────────────────────────────────────────
# The centralised root .env must never be committed — it contains secrets.
# .env.example IS committed — it documents all required variables safely.
.env
.env.local
.env.*.local

# ── Build output ──────────────────────────────────────────────────────────────
dist/
build/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*

# ── Uploaded files ────────────────────────────────────────────────────────────
# Ignore content but track the directory skeleton via .gitkeep
backend/uploads/*
!backend/uploads/.gitkeep

# ── Frontend HTML entry ───────────────────────────────────────────────────────
# index.html is not used by the application — HTML is generated at runtime by
# html-template.js (dev: transformIndexHtml; build: generateBundle emits dist/index.html).
# The file is kept empty on disk so the path remains gitignored.
frontend/index.html

# ── Editor / OS artefacts ─────────────────────────────────────────────────────
.DS_Store
.vscode/
.idea/
